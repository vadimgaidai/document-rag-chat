{
  "name": "document-rag-chat",
  "private": true,
  "type": "module",
  "description": "A personal workspace for exploring document search and AI chat with TanStack Start and AWS.",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "NITRO_PRESET=node-server vite build && vite preview",
    "generate-routes": "tsr generate",
    "messages": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "typecheck": "tsc --noEmit",
    "build:lambda": "esbuild src/lambda/ingestion.ts src/lambda/dlq.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist/lambda --entry-names=[name]/index",
    "eval:docs": "tsx eval/docs/generate.ts",
    "ingest:local": "tsx --env-file-if-exists=.env scripts/ingest-local.ts",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --report-unused-disable-directives --fix",
    "lint:staged": "lint-staged --relative",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:fix": "stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run --config vitest.eval.config.ts",
    "eval:html": "vitest run --config vitest.eval.config.ts --reporter=html --outputFile=eval/report/index.html",
    "check": "pnpm format:check && pnpm lint && pnpm stylelint && pnpm typecheck && pnpm test",
    "prepare": "husky",
    "postinstall": "pnpm run messages"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1139.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1138.0",
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/client-s3vectors": "^3.1138.0",
    "@aws-sdk/s3-presigned-post": "^3.1138.0",
    "@langchain/textsplitters": "^1.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "^0.59.0",
    "@tanstack/ai-bedrock": "^0.3.13",
    "@tanstack/ai-react": "^0.28.0",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.57",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.577.0",
    "mdast-util-to-string": "^4.0.0",
    "minisearch": "^7.2.0",
    "motion": "^13.4.3",
    "next-themes": "^0.4.6",
    "p-throttle": "^8.1.1",
    "query-string": "^9.5.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "vfile-location": "^5.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@inlang/paraglide-js": "^2.25.4",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/ai-client": "0.34.0",
    "@tanstack/devtools-event-client": "^0.5.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-plugin-query": "^5.103.2",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/eslint-plugin-start": "^0.1.0",
    "@tanstack/router-cli": "^1.167.38",
    "@types/aws-lambda": "^8.10.163",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "nitro": "3.0.260903-beta",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "unrs-resolver"
    ]
  },
  "intent": {
    "skills": [
      "@tanstack/ai#ai-core",
      "@tanstack/ai#ai-core/ag-ui-protocol",
      "@tanstack/ai#ai-core/chat-experience",
      "@tanstack/ai#ai-core/client-persistence",
      "@tanstack/ai#ai-core/custom-backend-integration",
      "@tanstack/ai#ai-core/middleware",
      "@tanstack/ai#ai-core/structured-outputs",
      "@tanstack/ai#ai-core/tool-calling",
      "@tanstack/markdown#render-markdown",
      "@tanstack/react-start#react-start",
      "@tanstack/react-start#react-start/server-components",
      "@tanstack/router-core#router-core",
      "@tanstack/router-core#router-core/code-splitting",
      "@tanstack/router-core#router-core/data-loading",
      "@tanstack/router-core#router-core/navigation",
      "@tanstack/router-core#router-core/ssr",
      "@tanstack/router-core#router-core/type-safety"
    ]
  }
}
